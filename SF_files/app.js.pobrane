/* eslint-disable */
/**
 * IMPORTANT NOTE:
 *      Changes to the service worker must be backwards compatible.
 *      There is a possibility that both the old and new versions can be live at once.
 */
self.addEventListener('install', function (event) {
    //Forces this version of service worker to take over
    event.waitUntil(self.skipWaiting());
});

self.addEventListener('activate', function (event) {
    //Makes sure the clients all get this new version
    event.waitUntil(self.clients.claim());
});

self.addEventListener('message', function (event) {
    if(event.origin != self.location.origin) {
        return;
    }

    if (event.data && event.data.type) {
        var data = event.data;

        if (data.type == 'showNotification') {
            self.registration.showNotification(data.title, data.options);
        } else if (data.type == 'dismissNotification') {
            self.registration.getNotifications(data.options).then(function (notifications) {
                notifications.forEach(function (n) {
                    n.close();
                });
            });

        }
    }

});

self.addEventListener('notificationclick', function(event) {
    event.preventDefault();

    var data = {
        action: event.action,
        tag: event.notification.tag
    };

    //Send message to all clients about what was clicked
    self.clients.matchAll().then(function (clientList) {
        clientList.forEach(function (client) {
            client.postMessage(data);
        });
    });

    event.notification.close();

}, false);